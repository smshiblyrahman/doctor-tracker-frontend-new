# Where Next.js proxies /api/v1/* (the API gateway). Server-side only.
# Local dev: http://localhost:5000
# Vercel: set to your Render gateway URL, e.g. https://doctor-tracker-gateway.onrender.com
API_GATEWAY_URL=http://localhost:5000
# Base path the browser calls. Keep the default to use the same-origin proxy above;
# set to an absolute gateway URL (e.g. http://localhost:5000/api/v1) to call it directly.
NEXT_PUBLIC_API_BASE_URL=/api/v1
